# Copy to .env, or run `node setup.js` which asks for each value and writes .env securely.
# Admin accounts are NOT configured here: they live in the database (node setup.js or node scripts/admin-user.js <name>).

# HTTP port (nginx proxies to it)
PORT=3100

# MargaTrack live feed — integration key + client id + Rath vehicle id (see tracaar_clone/ERP-INTEGRATION.md)
MARGATRACK_URL=https://margatrack.com
MARGATRACK_API_KEY=
MARGATRACK_CLIENT_ID=
MARGATRACK_VEHICLE_ID=

# Google Maps JavaScript API key — restrict it to your domain (HTTP referrer) in Google Cloud console
GOOGLE_MAPS_KEY=

# 1 = admin cookie sent only over HTTPS (production). 0 only for local http testing.
COOKIE_SECURE=1

# Contact the push services can reach (https URL or mailto:)
VAPID_SUBJECT=https://margatrack.com

# SQLite database file (back it up: holds admins, push keys and subscriptions)
DB_FILE=rathyatra.db
